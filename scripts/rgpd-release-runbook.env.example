# RGPD release script environment template
#
# Usage:
#   cp scripts/rgpd-release-runbook.env.example .env.rgpd
#   # edit values in .env.rgpd
#   set -a; source .env.rgpd; set +a
#   ./scripts/rgpd-release-runbook.sh --dry-run
#
# Do NOT commit real secrets/tokens.

# Required for API health + maintenance RGPD endpoints
API_BASE_URL="https://api.seu-dominio.pt"

# Required for maintenance RGPD endpoints (Manager JWT)
# Prefer generating a short-lived token right before the maintenance window.
API_BEARER_TOKEN="<MANAGER_JWT_TOKEN_AQUI>"

# Required for SQL validation scripts (psql)
# Example format:
# postgresql://username:password@host:5432/database?sslmode=require
DATABASE_URL="postgresql://habitus:change-me@localhost:5432/habitus"

# Optional tunables
POLL_INTERVAL_SECONDS="10"
POLL_TIMEOUT_SECONDS="1800"
RGPD_LOG_DIR="/tmp/habitus-rgpd"
